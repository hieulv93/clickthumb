{
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/gaming",
      "destination": "/gaming-thumbnail-maker/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy/",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy-policy/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-make-a-thumbnail-without-canva",
      "destination": "/blog/how-to-make-thumbnail-without-canva/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-make-a-thumbnail-without-canva/",
      "destination": "/blog/how-to-make-thumbnail-without-canva/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-make-a-youtube-thumbnail-without-photoshop",
      "destination": "/blog/how-to-make-youtube-thumbnail-without-photoshop/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-make-a-youtube-thumbnail-without-photoshop/",
      "destination": "/blog/how-to-make-youtube-thumbnail-without-photoshop/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
